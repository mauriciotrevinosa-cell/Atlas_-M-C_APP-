# ============================================
# PROJECT ATLAS — Environment Configuration
# ============================================
# Copy this file to .env and fill in your keys.
# All API keys are OPTIONAL — Atlas degrades gracefully.
# Providers without keys are simply skipped in the fallback chain.

# ============================================
# LLM Backend (choose one as primary)
# ============================================
# ollama    = Local, free, private (DEFAULT — no key needed)
# groq      = Cloud, free tier available
# openrouter = Cloud, some free models
# cerebras  = Cloud, free tier
# anthropic = Cloud, paid
# openai    = Cloud, paid
ARIA_LLM_BACKEND=ollama

# ============================================
# LLM Providers
# ============================================
# -- Ollama (Local, FREE, no key needed) --
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# -- Groq (FREE tier: 30 req/min) --
# Sign up: https://console.groq.com
# GROQ_API_KEY=gsk_your-key-here

# -- OpenRouter (some FREE models) --
# Sign up: https://openrouter.ai
# OPENROUTER_API_KEY=sk-or-your-key-here

# -- Cerebras (FREE tier available) --
# Sign up: https://cloud.cerebras.ai
# CEREBRAS_API_KEY=your-key-here

# -- Anthropic Claude (PAID) --
# Sign up: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# -- OpenAI (PAID) --
# Sign up: https://platform.openai.com
# OPENAI_API_KEY=sk-proj-your-key-here

# ============================================
# Market Data APIs
# ============================================
# -- Alpha Vantage (FREE: 25 calls/day) --
# Sign up: https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_KEY=your-key-here

# -- Finnhub (FREE: 60 calls/min) --
# Sign up: https://finnhub.io/register
# FINNHUB_API_KEY=your-key-here

# -- Polygon.io (FREE: 5 calls/min) --
# Sign up: https://polygon.io/dashboard/signup
# POLYGON_API_KEY=your-key-here

# -- Twelve Data (FREE: 800 calls/day) --
# Sign up: https://twelvedata.com/account
# TWELVE_DATA_KEY=your-key-here

# -- CoinGecko (FREE: 10-30 calls/min, optional key) --
# Sign up: https://www.coingecko.com/en/api
# COINGECKO_API_KEY=your-key-here

# ============================================
# Economic & Macro Data APIs
# ============================================
# -- FRED / St. Louis Fed (FREE: unlimited) --
# Sign up: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=your-key-here

# ============================================
# News & Sentiment APIs
# ============================================
# -- NewsAPI (FREE: 100 calls/day) --
# Sign up: https://newsapi.org/register
# NEWSAPI_KEY=your-key-here

# -- Reddit API (FREE: 100 calls/min) --
# Sign up: https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=your-client-id
# REDDIT_CLIENT_SECRET=your-secret
# REDDIT_USER_AGENT=atlas:v5.0.0 (by /u/your-username)

# ============================================
# AI & Machine Learning APIs
# ============================================
# -- HuggingFace (FREE: rate-limited) --
# Sign up: https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=hf_your-key-here

# ============================================
# Broker / Execution APIs
# ============================================
# -- Alpaca (FREE paper trading) --
# Sign up: https://app.alpaca.markets/signup
# ALPACA_API_KEY=your-key-here
# ALPACA_SECRET_KEY=your-secret-here
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ============================================
# SEC EDGAR (FREE, no key — just User-Agent)
# ============================================
# Required format: "Company Name email@example.com"
SEC_EDGAR_USER_AGENT=M&C Atlas dev@example.com

# ============================================
# General Settings
# ============================================
ARIA_MAX_TOKENS=4096
ARIA_TEMPERATURE=0.7
ARIA_VOICE_MODE=basic
ARIA_MEMORY_TYPE=local

# ============================================
# Data Layer Settings
# ============================================
# Provider priority (comma-separated, first = preferred)
DATA_PROVIDER_PRIORITY=polygon,finnhub,alphavantage,yahoo
NEWS_PROVIDER_PRIORITY=finnhub,newsapi,rss
MACRO_PROVIDER_PRIORITY=fred

# Cache settings
DATA_CACHE_TTL_MINUTES=15
DATA_CACHE_DIR=data/cache

# ============================================
# WhatsApp Command Station (Twilio)
# ============================================
# pip install twilio flask anthropic
# TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_TOKEN=your-auth-token
# TWILIO_WA_NUMBER=whatsapp:+14155238886
# WHATSAPP_PORT=5001
# WHATSAPP_AUTHORIZED=whatsapp:+521234567890   # Your WA number — leave blank to allow all

# Atlas API URL (where server.py is reachable from the WhatsApp bot)
ATLAS_API_URL=http://localhost:8088

# ============================================
# 24/7 Daemon Settings
# ============================================
DAEMON_MAX_RESTARTS=10        # crashes before daemon gives up
DAEMON_MAX_WINDOW_SEC=300     # window for counting crashes (seconds)
DAEMON_UPGRADE_CMD=git pull --ff-only
